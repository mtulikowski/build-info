{
    "name": "smartgroup/build-info-bundle",
    "description": "Symfony bundle for application build metadata",
    "type": "symfony-bundle",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/process": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/twig-bundle": "^6.4 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "SmartGroup\\BuildInfoBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SmartGroup\\BuildInfoBundle\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "mtulikowski",
            "email": "mariusz@tulikowski.eu"
        }
    ]
}
